# .env.example — Variables de entorno para WhatsApp AgentKit (Valoz Digital)
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
WHATSAPP_PROVIDER=meta

# ── Meta Cloud API ─────────────────────────────────────────
# Configurar en: https://developers.facebook.com → tu app → WhatsApp
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=

# ── Meta Embedded Signup (solo para /embedded-signup-test) ─
# App ID y Config ID de Embedded Signup de tu app de Meta.
# No son secretos (viajan al navegador), pero NUNCA pongas aquí el App Secret.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=production
TIMEZONE=America/Mexico_City

# ── Base de datos ─────────────────────────────────────────
# SQLite local (por defecto — Railway lo maneja automáticamente)
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db

# ── Google Sheets (opcional) ───────────────────────────────
# Dejar vacío para desactivar. Si se configura, guarda leads automáticamente.
# Guía completa en README_CLIENT_SETUP.md
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La private_key del JSON con \n como literal (no saltos de línea reales):
GOOGLE_PRIVATE_KEY=

# ── Google Calendar (opcional) ─────────────────────────────
# Dejar vacío para desactivar. Comparte el Calendar con GOOGLE_SERVICE_ACCOUNT_EMAIL.
GOOGLE_CALENDAR_ID=

# ── Instagram DM y Facebook Messenger (opcional, solo Jarvis Valoz) ────────
# Deshabilitado por defecto — no afecta a WhatsApp ni a otros clientes (ej. Renzo
# Snacks) aunque queden sin llenar. Guía completa en README_META_INSTAGRAM_FACEBOOK.md
INSTAGRAM_ENABLED=false
FACEBOOK_MESSENGER_ENABLED=false
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
VALOZ_WHATSAPP_LINK=https://wa.me/529615805721
