# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Servidor ──────────────────────────────────────────────
TIMEZONE=America/Mexico_City

# ── Google Sheets (opcional) ───────────────────────────────
# Dejar vacío para desactivar. Si se configura, guarda leads automáticamente.
# 1. Crea una cuenta de servicio en console.cloud.google.com
# 2. Descarga el JSON de credenciales
# 3. Comparte el Google Sheet con el email de la cuenta de servicio
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La private_key del JSON, con \n como literal (no saltos de línea reales):
GOOGLE_PRIVATE_KEY=

# ── Google Calendar (opcional) ─────────────────────────────
# Dejar vacío para desactivar. Si se configura, crea eventos de citas.
# Comparte el Calendar con el email de la cuenta de servicio.
GOOGLE_CALENDAR_ID=
